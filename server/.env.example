# Port on which the Express server runs (e.g., 5000)
PORT=5000
# MongoDB Atlas connection string
MONGO_URI=
# Secret key used to sign JSON Web Tokens
JWT_SECRET=
# Base URL of the client application (e.g., http://localhost:5173)
CLIENT_URL=
# VAPID Public Key for Web Push Notifications
VAPID_PUBLIC_KEY=
# VAPID Private Key for Web Push Notifications
VAPID_PRIVATE_KEY=
# VAPID Subject for Web Push Notifications (mailto link)
VAPID_SUBJECT=
# Google Gemini API key for AI triage
GEMINI_API_KEY=
# Twilio Account SID (for SMS reminders)
TWILIO_ACCOUNT_SID=
# Twilio Auth Token
TWILIO_AUTH_TOKEN=
# Twilio Phone Number
TWILIO_PHONE_NUMBER=
# Cloudinary Cloud Name (for photo uploads)
CLOUDINARY_CLOUD_NAME=
# Cloudinary API Key
CLOUDINARY_API_KEY=
# Cloudinary API Secret
CLOUDINARY_API_SECRET=
